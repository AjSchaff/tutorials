<odoo>
  <record id="estate_property_offer_form_view" model="ir.ui.view">
    <field name="name">estate.property.offer.view.list</field>
    <field name="model">estate.property.offer</field>
    <field name="arch" type="xml">
      <list string="Offers" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
        <field name="price" string="Price"/>
        <field name="partner_id" string="Partner"/>
        <field name="validity" string="Validity"/>
        <field name="date_deadline" string="Date Deadline" column_invisible="parent.status == 'sold'"/>
        <field name="status" string="Status" optional="False"/>
        <button name="action_accept" invisible="status in ('accepted', 'refused')" type="object" icon="fa-check" />
        <button name="action_refuse" invisible="status in ('accepted', 'refused')" type="object" icon="fa-times" />
        <field name="property_type_id" string="Property Type"/>
      </list>
    </field>
  </record>
</odoo>